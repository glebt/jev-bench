{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "E-Commerce Order",
  "type": "object",
  "required": ["order_id", "customer", "items", "shipping", "payment", "timestamps"],
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^ORD-[A-Z0-9]{12}$"
    },
    "customer": {
      "type": "object",
      "required": ["id", "email", "name", "tier"],
      "properties": {
        "id": { "type": "string", "pattern": "^CUST-\\d{6}$" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "tier": { "type": "string", "enum": ["bronze", "silver", "gold", "platinum"] },
        "loyalty_points": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["sku", "name", "quantity", "unit_price", "category"],
        "properties": {
          "sku": { "type": "string", "pattern": "^SKU-[A-Z]{3}-\\d{5}$" },
          "name": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 100 },
          "unit_price": { "type": "number", "minimum": 0.01, "maximum": 10000 },
          "discount": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
          "category": { "type": "string", "enum": ["electronics", "clothing", "home", "books", "sports", "beauty"] },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 10
          },
          "metadata": {
            "type": "object",
            "properties": {
              "weight_kg": { "type": "number", "minimum": 0 },
              "dimensions_cm": {
                "type": "object",
                "properties": {
                  "length": { "type": "number" },
                  "width": { "type": "number" },
                  "height": { "type": "number" }
                }
              },
              "warranty_months": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "shipping": {
      "type": "object",
      "required": ["address", "method", "estimated_delivery"],
      "properties": {
        "address": {
          "type": "object",
          "required": ["street", "city", "state", "postal_code", "country"],
          "properties": {
            "street": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "postal_code": { "type": "string" },
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
          }
        },
        "method": { "type": "string", "enum": ["standard", "express", "overnight", "pickup"] },
        "estimated_delivery": { "type": "string", "format": "date-time" },
        "tracking_number": { "type": ["string", "null"], "pattern": "^[A-Z0-9]{10,20}$" }
      }
    },
    "payment": {
      "type": "object",
      "required": ["method", "amount", "currency", "status"],
      "properties": {
        "method": { "type": "string", "enum": ["credit_card", "debit_card", "paypal", "apple_pay", "google_pay", "bank_transfer"] },
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "status": { "type": "string", "enum": ["pending", "authorized", "captured", "refunded", "failed"] },
        "transaction_id": { "type": "string" },
        "installments": { "type": "integer", "minimum": 1, "maximum": 24, "default": 1 }
      }
    },
    "timestamps": {
      "type": "object",
      "required": ["created_at", "updated_at"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "confirmed_at": { "type": ["string", "null"], "format": "date-time" },
        "shipped_at": { "type": ["string", "null"], "format": "date-time" },
        "delivered_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "notes": { "type": ["string", "null"], "maxLength": 1000 },
    "metadata": {
      "type": "object",
      "properties": {
        "source": { "type": "string", "enum": ["web", "mobile", "api", "pos"] },
        "utm_source": { "type": "string" },
        "utm_medium": { "type": "string" },
        "utm_campaign": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}