{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Company with Employees",
  "type": "object",
  "required": ["company", "employees"],
  "properties": {
    "company": {
      "type": "object",
      "required": ["name", "founded", "headquarters"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "founded": { "type": "integer", "minimum": 1800, "maximum": 2025 },
        "headquarters": {
          "type": "object",
          "required": ["city", "country"],
          "properties": {
            "city": { "type": "string" },
            "country": { "type": "string" },
            "coordinates": {
              "type": "object",
              "properties": {
                "lat": { "type": "number" },
                "lng": { "type": "number" }
              }
            }
          }
        },
        "industry": { "type": "string", "enum": ["tech", "finance", "healthcare", "manufacturing", "retail"] }
      }
    },
    "employees": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "skills"],
        "properties": {
          "id": { "type": "string", "pattern": "^EMP-\\d{4}$" },
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["engineer", "manager", "designer", "analyst", "executive"] },
          "skills": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 10
          },
          "salary": { "type": "number", "minimum": 30000, "maximum": 500000 },
          "start_date": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "additionalProperties": false
}