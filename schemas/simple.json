{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Simple Person",
  "type": "object",
  "required": ["name", "age", "email"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 150
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false
}